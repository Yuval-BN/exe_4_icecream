QMainWindow {
    background-color: #f7f5f2;
}

QWidget {
    color: #333333;
    font-family: "Segoe UI";
    font-size: 14px;
}

QPushButton {
    background-color: #e97c5b;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 9px 18px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #d96b4a;
}

QPushButton:pressed {
    background-color: #c85b3c;
}

QToolBar {
    background-color: #ffffff;
    border: none;
    spacing: 6px;
    padding: 5px;
}

QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 5px;
}

QToolButton:hover {
    background-color: #f0ece8;
}
